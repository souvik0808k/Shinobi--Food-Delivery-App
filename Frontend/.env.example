# Firebase API Key (Safe to expose - restricted by domain in Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Geoapify API Key (Safe to expose - restricted by domain/referrer in Geoapify Dashboard)
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Note: VITE_ prefixed variables are client-side and will be public in the browser.
# Both Firebase and Geoapify keys are designed to be public-facing and secured
# through domain restrictions configured in their respective dashboards.
